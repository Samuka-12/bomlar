# Valores públicos do projeto Supabase, injetados no servidor pela configuração protegida.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Somente no servidor. Nunca expor em variáveis NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
# O domínio público real da loja, quando configurado.
NEXT_PUBLIC_SITE_URL=
# Pixel de anúncios; sem ID não carrega nem envia eventos.
NEXT_PUBLIC_META_PIXEL_ID=
# Gateway ainda não selecionado. Nenhuma cobrança é processada sem integração.
